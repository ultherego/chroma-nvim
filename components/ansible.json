{
  "contract": 5,
  "id": "ansible",
  "name": "Ansible",
  "description": "Playbooks and roles: the language server, linting and documentation.",
  "requires": [
    "core"
  ],
  "tools": {
    "optional": [
      {
        "id": "ansible-doc",
        "reason": "documentation lookup through keywordprg"
      }
    ]
  },
  "nvim": {
    "servers": [
      "ansiblels"
    ],
    "mason": [
      "ansible-lint"
    ],
    "plugins": [
      "nvim-ansible"
    ],
    "linters": [
      "ansible_lint"
    ]
  }
}
