{
  "contract": 5,
  "id": "core",
  "name": "Core editor",
  "description": "The editor itself: plugin management, treesitter, pickers.",
  "requires": [],
  "tools": {
    "required": [
      {
        "id": "git",
        "reason": "lazy.nvim clones plugins, and partial clones need this",
        "version": {
          "min": "2.19"
        }
      },
      {
        "id": "curl",
        "reason": "downloading parsers and prebuilt binaries"
      },
      {
        "id": "tar",
        "reason": "unpacking treesitter grammars"
      },
      {
        "id": "unzip",
        "reason": "Mason unpacks packages with it and fails without it"
      },
      {
        "id": "gzip",
        "reason": "Mason unpacks packages with it and fails without it"
      },
      {
        "any": [
          "cc",
          "gcc",
          "clang"
        ],
        "reason": "treesitter parsers are compiled locally"
      },
      {
        "id": "tree-sitter",
        "reason": "compiling parsers, from a package manager rather than npm",
        "version": {
          "min": "0.26.1"
        }
      }
    ],
    "recommended": [
      {
        "id": "fzf",
        "reason": "every picker",
        "version": {
          "min": "0.36"
        }
      },
      {
        "id": "rg",
        "reason": "the grep pickers"
      },
      {
        "id": "fd",
        "reason": "project detection"
      },
      {
        "id": "bat",
        "reason": "file previews in the fzf-native profile"
      }
    ],
    "optional": [
      {
        "id": "yazi",
        "reason": "the file manager on <leader>fy"
      },
      {
        "id": "lazygit",
        "reason": "the git UI on <leader>gg"
      }
    ]
  },
  "nvim": {
    "servers": [
      "yamlls",
      "jsonls",
      "bashls",
      "lua_ls"
    ],
    "mason": [
      "yamllint",
      "stylua",
      "shfmt",
      "jq"
    ],
    "parsers": [
      "yaml",
      "bash",
      "python",
      "lua",
      "json",
      "toml",
      "ini",
      "xml",
      "sql",
      "make",
      "ssh_config",
      "go",
      "gomod",
      "git_config",
      "gitcommit",
      "gitignore",
      "diff",
      "markdown",
      "markdown_inline",
      "regex",
      "query",
      "vim",
      "vimdoc"
    ],
    "linters": [
      "yamllint"
    ],
    "formatters": [
      "stylua",
      "shfmt",
      "jq"
    ]
  }
}
