# lazy.nvim (lazy-lock.json is tracked on purpose — reproducible plugin set)
lazy-lock.json.bak

# runtime / state
.luarc.json
*.log
spell/
shada/
sessions/

# editor / os
.DS_Store
*.swp
*~
.direnv/

# Go build output (the CLI is built by CI and by releases, never committed)
cli/chroma

# Release artefacts, built by `chroma package`. They are published to a
# GitHub Release, which is the only place they belong.
dist/

# Planning documents. The executive plan was swept into a commit by a careless
# `git add -A`; it is the owner's working document, not part of the product.
*.docx
